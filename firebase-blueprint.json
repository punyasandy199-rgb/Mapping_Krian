{
  "entities": {
    "PalletRecord": {
      "title": "PalletRecord",
      "description": "A warehouse pallet record registered with barcode and bin location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorPallet": { "type": "string" },
        "barcodeNumber": { "type": "string" },
        "batchId": { "type": "string" },
        "itemIndex": { "type": "number" },
        "kodeItem": { "type": "string" },
        "namaBarang": { "type": "string" },
        "qtyPallet": { "type": "number" },
        "unit": { "type": "string" },
        "noBatch": { "type": "string" },
        "boxAwal": { "type": "string" },
        "boxAkhir": { "type": "string" },
        "batchAwal": { "type": "string" },
        "batchAkhir": { "type": "string" },
        "batches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "noBatch": { "type": "string" },
              "boxAwal": { "type": "string" },
              "boxAkhir": { "type": "string" },
              "qtyBox": { "type": "number" }
            }
          }
        },
        "lokasiBin": { "type": "string" },
        "keterangan": { "type": "string" },
        "submittedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastUpdateAction": { "type": "string" },
        "binOrder": { "type": "number" }
      },
      "required": [
        "id",
        "barcodeNumber",
        "namaBarang",
        "qtyPallet",
        "lokasiBin",
        "submittedAt"
      ]
    },
    "MasterItem": {
      "title": "MasterItem",
      "description": "Warehouse SKU catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeItem": { "type": "string" },
        "namaBarang": { "type": "string" },
        "satuan": { "type": "string" },
        "defaultQty": { "type": "number" },
        "beratPerBoxKg": { "type": "number" },
        "kategori": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "kodeItem",
        "namaBarang"
      ]
    },
    "MasterRouteTariff": {
      "title": "MasterRouteTariff",
      "description": "Freight route and multi-vendor pricing record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ruteAwal": { "type": "string" },
        "ruteTujuan": { "type": "string" },
        "alamatTujuan": { "type": "string" },
        "vendor": { "type": "string" },
        "tarif": { "type": "number" },
        "ppnPersen": { "type": "number" }
      },
      "required": [
        "id",
        "ruteAwal",
        "ruteTujuan",
        "vendor",
        "tarif"
      ]
    },
    "BlacklistRecord": {
      "title": "BlacklistRecord",
      "description": "Blacklist record for trucks, drivers, vendors, or pallets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipe": { "type": "string" },
        "identifier": { "type": "string" },
        "alasan": { "type": "string" },
        "tanggal": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": [
        "id",
        "tipe",
        "identifier",
        "alasan"
      ]
    },
    "WarehouseUser": {
      "title": "WarehouseUser",
      "description": "Warehouse operator and administrator user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": [
        "id",
        "nama",
        "username",
        "role"
      ]
    },
    "MasterWarehouse": {
      "title": "MasterWarehouse",
      "description": "Warehouse location group and sub-location configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationGroup": { "type": "string" },
        "kodeGudang": { "type": "string" },
        "namaGudang": { "type": "string" },
        "subtitle": { "type": "string" },
        "status": { "type": "string" },
        "rackLeftPrefix": { "type": "string" },
        "rackRightPrefix": { "type": "string" },
        "leftSlotCount": { "type": "number" },
        "rightSlotCount": { "type": "number" },
        "rightPrimaryCount": { "type": "number" },
        "keterangan": { "type": "string" }
      },
      "required": [
        "id",
        "locationGroup",
        "kodeGudang",
        "namaGudang",
        "status"
      ]
    }
  },
  "firestore": {
    "/pallet_records/{recordId}": {
      "schema": {
        "$ref": "#/entities/PalletRecord"
      },
      "description": "Collection of inbound pallet records synced across warehouse devices"
    },
    "/master_items/{itemId}": {
      "schema": {
        "$ref": "#/entities/MasterItem"
      },
      "description": "Catalog of warehouse products and SKUs"
    },
    "/master_route_tariffs/{tariffId}": {
      "schema": {
        "$ref": "#/entities/MasterRouteTariff"
      },
      "description": "Route destinations and vendor freight tariffs"
    },
    "/master_blacklist/{blacklistId}": {
      "schema": {
        "$ref": "#/entities/BlacklistRecord"
      },
      "description": "Operational blacklist records"
    },
    "/warehouse_users/{userId}": {
      "schema": {
        "$ref": "#/entities/WarehouseUser"
      },
      "description": "Warehouse operators and supervisors"
    },
    "/master_warehouses/{warehouseId}": {
      "schema": {
        "$ref": "#/entities/MasterWarehouse"
      },
      "description": "Warehouse locations and sub-locations"
    }
  }
}
