rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Pallet Records for real-time warehouse sync across operator devices
    match /pallet_records/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId)
        && request.resource.data.id is string
        && request.resource.data.barcodeNumber is string
        && request.resource.data.namaBarang is string
        && request.resource.data.qtyPallet is number
        && request.resource.data.lokasiBin is string;
      allow update: if isValidId(recordId)
        && request.resource.data.id == resource.data.id;
      allow delete: if isValidId(recordId);
    }

    // Master items catalog
    match /master_items/{itemId} {
      allow read: if true;
      allow create: if isValidId(itemId)
        && request.resource.data.id is string
        && request.resource.data.kodeItem is string
        && request.resource.data.namaBarang is string;
      allow update: if isValidId(itemId);
      allow delete: if isValidId(itemId);
    }

    // Master routes (lokasi asal & tujuan beserta alamat)
    match /master_routes/{routeId} {
      allow read: if true;
      allow create, update, delete: if isValidId(routeId);
    }

    // Master vendor armada (vendor, tarif, PPN)
    match /master_vendors/{vendorId} {
      allow read: if true;
      allow create, update, delete: if isValidId(vendorId);
    }

    // Master Tujuan & Tarif (Multi-vendor & Bolak-balik)
    match /master_route_tariffs/{tariffId} {
      allow read: if true;
      allow create, update, delete: if isValidId(tariffId);
    }

    // Master Blacklist (Nopol, Driver, Vendor, Pallet)
    match /master_blacklist/{blacklistId} {
      allow read: if true;
      allow create, update, delete: if isValidId(blacklistId);
    }

    // Warehouse Users (Operator, Supervisor, Admin)
    match /warehouse_users/{userId} {
      allow read: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // Surat Jalan / Delivery Note records
    match /surat_jalan_records/{suratId} {
      allow read: if true;
      allow create, update, delete: if isValidId(suratId);
    }

    // Master Gudang & Sub-Location
    match /master_warehouses/{warehouseId} {
      allow read: if true;
      allow create, update, delete: if isValidId(warehouseId);
    }
  }
}
